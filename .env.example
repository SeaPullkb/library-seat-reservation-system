# 复制为 .env 并填写；docker compose 读取本文件，Java 进程需要另行导出变量。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=library_seat
DB_USERNAME=library
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
# dev 模式下的三个本地演示账号共用此密码，请设置至少12位。
APP_DEMO_PASSWORD=
# 非 dev 模式首次启动时，用此密码创建 admin 超级管理员，至少12位。
APP_BOOTSTRAP_ADMIN_PASSWORD=
